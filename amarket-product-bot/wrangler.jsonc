{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amarket-product-bot",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-26",
  "workers_dev": true,
  "secrets": {
    "required": [
      "TELEGRAM_BOT_TOKEN",
      "WEBHOOK_SECRET",
      "ALLOWED_USER_IDS",
      "CHANNEL_ID"
    ]
  }
}
