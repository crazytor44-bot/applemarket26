{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amarket-product-bot",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-26",
  "workers_dev": true,
  "vars": {
    "CHANNEL_ID": "@applemarket26"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PROFILES",
        "class_name": "StoreProfile"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["StoreProfile"]
    }
  ],
  "secrets": {
    "required": [
      "TELEGRAM_BOT_TOKEN",
      "WEBHOOK_SECRET",
      "ALLOWED_USER_IDS"
    ]
  }
}
